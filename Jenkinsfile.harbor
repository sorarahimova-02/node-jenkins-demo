pipeline {
    agent any
    
    environment {
        HARBOR_URL = "localhost"
        HARBOR_PROJECT = "devops"
        APP_NAME = "node-jenkins-demo"
        IMAGE = "${HARBOR_URL}/${HARBOR_PROJECT}/${APP_NAME}"
        CONTAINER_NAME = "node-app"
    }
    
    stages {
        stage('Build') {
            steps {
                echo "Building Docker image..."
                sh 'docker build -t ${IMAGE}:${BUILD_NUMBER} .'
                sh 'docker tag ${IMAGE}:${BUILD_NUMBER} ${IMAGE}:latest'
            }
        }
        
        stage('Push to Harbor') {
            steps {
                echo "Pushing to Harbor..."
                withCredentials([usernamePassword(
                    credentialsId: 'harbor-credentials',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                        echo $PASS | docker login -u $USER --password-stdin $HARBOR_URL
                        docker push ${IMAGE}:${BUILD_NUMBER}
                        docker push ${IMAGE}:latest
                        docker logout $HARBOR_URL
                    '''
                }
            }
        }
        
        stage('Pull from Harbor') {
            steps {
                echo "Pulling fresh image from Harbor..."
                withCredentials([usernamePassword(
                    credentialsId: 'harbor-credentials',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                        echo $PASS | docker login -u $USER --password-stdin $HARBOR_URL
                        docker pull ${IMAGE}:latest
                        docker logout $HARBOR_URL
                    '''
                }
            }
        }
        
        stage('Deploy - Run Container from Harbor') {
            steps {
                echo "Deploying container from Harbor image..."
                sh '''
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true
                    
                    docker run -d \
                      --name ${CONTAINER_NAME} \
                      -p 3000:3000 \
                      -e NODE_ENV=production \
                      -e VERSION=${BUILD_NUMBER} \
                      ${IMAGE}:latest
                    
                    docker ps | grep ${CONTAINER_NAME}
                '''
            }
        }
        
        stage('Health Check') {
            steps {
                echo "Checking app health..."
                sh '''
                    sleep 5
                    curl -f http://localhost:3000/health || {
                        echo "Health check FAILED!"
                        docker logs ${CONTAINER_NAME}
                        exit 1
                    }
                    echo "✓ App is healthy!"
                '''
            }
        }
    }
    
    post {
        success {
            sh 'echo "✓ App is running from Harbor image at http://localhost:3000"'
        }
        failure {
            sh 'docker stop ${CONTAINER_NAME} || true'
        }
    }
}
